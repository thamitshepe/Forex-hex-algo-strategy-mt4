# The names deploy/docker-compose.yml interpolates. CI does not read this file:
# .github/workflows/deploy.yml builds the same KEY=VALUE block from repository
# variables and secrets (DEPLOY.md §5) and sends it to Dokploy, which writes it to
# the .env beside the compose file. This copy is for running compose by hand.
#
# One file, several applications: instance 1 reads the plain names below, instance
# 2 reads their "2" copies (MT4_LOGIN2, MT4_SYMBOL2, ...). Set MT4_INSTANCE to say
# which one this container is. See the commented block at the end.

MT4_INSTANCE=1

# The demo account MetaTrader logs into. On MetaQuotes-Demo you can open a fresh
# one from the terminal itself: File > Open an Account. Anything broker-specific
# works too, as long as that broker's terminal is the one in MT4_DISTRO_URL.
MT4_LOGIN=
MT4_PASSWORD=
MT4_SERVER=MetaQuotes-Demo

# What and how to trade. The chart itself (symbol + timeframe + inputs) comes from
# the profile in the volume; these two decide which expert and which preset the
# terminal attaches.
MT4_SYMBOL=XAUUSD
# Optional: move the volume's profile chart onto this timeframe (5, 15, 60, ...).
# Empty = leave the chart's own timeframe alone. An instance that asks for a
# symbol the profile does not carry gets the chart moved, not a second chart -
# two charts load the expert twice.
# MT4_PERIOD=
MT4_PRESET=100usd-demo
MT4_PROFILE=default

# The remote desktop. Set VNC_PASSWORD or there is no desktop, deliberately.
ENABLE_VNC=1
VNC_PASSWORD=

# UTC, because StartTradingHourUTC / StopTradingHourUTC in the preset are UTC.
TZ=UTC

# Optional. A prepared terminal tarball from deploy/scripts/prepare-distro.sh:
# leave empty to let the container install its own, or point at a file in the
# volume: file:///data/mt4-portable.tar.gz
MT4_DISTRO_URL=

# Optional, and one-shot per archive. 1 replaces the tree in /data/mt4 with a fresh
# copy of MT4_DISTRO_URL even though a terminal.exe is already there - the profile,
# the saved login and the EA's CSV trade log go with it. The sha256 of the archive
# is recorded in /data/.seeded-from, so leaving the flag on cannot re-seed the same
# archive twice; delete that file to force it again.
MT4_FORCE_SEED=0

# Optional. The image to run. CI sets this to the tag it just pushed, so normally
# leave it out and the compose file's default (:live) applies. Writing an explicit
# commit SHA here is how a rollback is done.
# MT4_IMAGE=ghcr.io/thamitshepe/forex-hex-mt4:live

# Optional. The host port the desktop is published on. A second instance on the
# same host needs a different one (6081), or no published port at all if you reach
# the desktop through its domain.
# HOST_VNC_PORT=6080

# A second instance. Point a second application at the same image, with its own
# volume at /data and its own hostname, and give it MT4_INSTANCE=2. Everything it
# trades is then read from the "2" copies - and a missing copy is a refusal to
# boot rather than a fallback to the account above, because that fallback is how a
# copied application trades one account with another account's strategy:
#
# MT4_INSTANCE=2
# MT4_LOGIN2=<the other account>
# MT4_PASSWORD2=
# MT4_SERVER2=<that broker's server>
# MT4_SYMBOL2=DOGEUSD
# MT4_PERIOD2=5
# MT4_PRESET2=doge-scalp-shadow
# HOST_VNC_PORT=6081

