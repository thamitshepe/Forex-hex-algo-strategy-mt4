# The names deploy/docker-compose.yml interpolates. CI does not read this file:
# .github/workflows/deploy.yml builds the same KEY=VALUE block from repository
# variables and secrets (DEPLOY.md §5) and sends it to Dokploy, which writes it to
# the .env beside the compose file. This copy is for running compose by hand.

# The demo account MetaTrader logs into. On MetaQuotes-Demo you can open a fresh
# one from the terminal itself: File > Open an Account. Anything broker-specific
# works too, as long as that broker's terminal is the one in MT4_DISTRO_URL.
MT4_LOGIN=
MT4_PASSWORD=
MT4_SERVER=MetaQuotes-Demo

# What and how to trade. The chart itself (symbol + timeframe + inputs) comes from
# the profile in the volume; these two decide which expert and which preset the
# terminal attaches.
MT4_SYMBOL=XAUUSD
MT4_PRESET=100usd-demo
MT4_PROFILE=default

# The remote desktop. Set VNC_PASSWORD or there is no desktop, deliberately.
ENABLE_VNC=1
VNC_PASSWORD=

# UTC, because StartTradingHourUTC / StopTradingHourUTC in the preset are UTC.
TZ=UTC

# Optional. A prepared terminal tarball from deploy/scripts/prepare-distro.sh:
# leave empty to let the container install its own, or point at a file in the
# volume: file:///data/mt4-portable.tar.gz
MT4_DISTRO_URL=

# Optional, and one-shot. 1 replaces the tree in /data/mt4 with a fresh copy of
# MT4_DISTRO_URL even though a terminal.exe is already there - the profile and the
# saved account login are replaced with it. Use it after the distro changes; set it
# back to 0 afterwards, or every restart re-seeds.
MT4_FORCE_SEED=0

# Optional. The image to run. CI sets this to the tag it just pushed, so normally
# leave it out and the compose file's default (:live) applies. Writing an explicit
# commit SHA here is how a rollback is done.
# MT4_IMAGE=ghcr.io/thamitshepe/forex-hex-mt4:live
