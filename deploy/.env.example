# The names deploy/docker-compose.yml interpolates. One service, one container:
# mt5-boom, instance 1, Deriv demo, Boom 400 Index.
#
# CI does not read this file: .github/workflows/deploy.yml builds the KEY=VALUE
# block and sends it to Dokploy, which writes it to the .env beside the compose
# file. This copy is for running compose by hand.

# The Deriv demo account MetaTrader 5 logs into. MT5's start config logs the
# account in by itself ([Common] Login/Password/Server), so unlike MT4 there is
# no one-time manual login on the desktop.
MT5_LOGIN=41311895
MT5_PASSWORD=
MT5_SERVER=Deriv-Demo

# What to trade. The [StartUp] section of mt5.ini opens one chart on this
# symbol/timeframe and attaches the expert with this preset.
MT5_SYMBOL=Boom 400 Index
MT5_PERIOD=M15
MT5_EXPERT=HEX-BoomRider
MT5_PRESET=HEX-BoomRider

# Where the EA pushes trade events (HELLO at boot, OPEN/CLOSE trades, BLOWN).
# Set to an ntfy.sh topic URL and subscribe to that topic in the ntfy app.
# Leave empty to rely on MetaQuotes-ID push instead (needs the ID set in the
# terminal's Options > Notifications once on the VNC desktop).
MT5_NOTIFY_URL=

# The remote desktop. Set VNC_PASSWORD or there is no desktop, deliberately.
ENABLE_VNC=1
VNC_PASSWORD=

# UTC.
TZ=UTC

# The full MetaTrader 5 installer (verified live, 23.8MB). The container runs
# it under Wine with /auto and copies the tree into the volume - no tarball
# needed. Leave empty to rely on MT5_DISTRO_URL / a volume that already has a
# terminal64.exe.
MT5_SETUP_URL=https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe

# Optional. A prepared terminal tarball from deploy/scripts/prepare-distro.sh
# (wins over the installer when both are set).
# DISTRO - the guaranteed terminal source (default points at the frozen tree
# on GitHub Releases; CI compiles the EA against the same tree at build time,
# baking HEX-BoomRider.ex5 into the image). Override only to swap distros.
MT5_DISTRO_URL=https://github.com/thamitshepe/Forex-hex-algo-strategy-mt4/releases/download/mt5-portable-distro/mt5-portable.tar.gz

# Optional, one-shot per archive. 1 replaces the tree in /data/mt5 with a fresh
# copy of MT5_DISTRO_URL even though a terminal64.exe is already there. The URL
# is recorded in /data/.seeded-from, so leaving the flag on cannot re-seed the
# same archive twice.
MT5_FORCE_SEED=0

# Optional. The image to run. CI sets this to the tag it just pushed.
# MT5_IMAGE=ghcr.io/thamitshepe/forex-hex-mt5:live

# Optional. ONE-SHOT account move for an existing volume: set to 1 when this
# volume's /data/.hex-instance still names the OLD account and the login above
# is the new one. Unset again after the next start.
# MT5_RECLAIM_VOLUME=0
