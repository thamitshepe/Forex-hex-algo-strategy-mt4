# Copy to deploy/.env (or paste into Dokploy's environment editor) and fill in.
# deploy/docker-compose.yml reads these names.

# The demo account MetaTrader logs into. On MetaQuotes-Demo you can open a fresh
# one from the terminal itself: File > Open an Account. Anything broker-specific
# works too, as long as that broker's terminal is the one in MT4_DISTRO_URL.
MT4_LOGIN=
MT4_PASSWORD=
MT4_SERVER=MetaQuotes-Demo

# What and how to trade. The chart itself (symbol + timeframe + inputs) comes from
# the profile in the volume; these two decide which expert and which preset the
# terminal attaches.
MT4_SYMBOL=XAUUSD
MT4_PRESET=100usd-demo
MT4_PROFILE=default

# The remote desktop. Set VNC_PASSWORD or there is no desktop, deliberately.
ENABLE_VNC=1
VNC_PASSWORD=

# UTC, because StartTradingHourUTC / StopTradingHourUTC in the preset are UTC.
TZ=UTC

# Optional. A prepared terminal tarball from deploy/scripts/prepare-distro.sh:
# leave empty to let the container install its own, or point at a file in the
# volume: file:///data/mt4-portable.tar.gz
MT4_DISTRO_URL=
